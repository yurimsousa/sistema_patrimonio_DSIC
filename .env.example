APP_NAME="Sistema Patrimônio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://seu-dominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── Oracle Autonomous Database (Oracle Cloud) ────────────────────────────────
# Passo 1: Baixe o Wallet em: Oracle Cloud → Autonomous Database → DB Connection → Download Wallet
# Passo 2: Extraia o wallet em um diretório seguro no servidor (ex: /var/www/wallet/)
# Passo 3: Defina a variável de ambiente do sistema: TNS_ADMIN=/var/www/wallet
# Passo 4: O DB_TNS é o nome do serviço no arquivo tnsnames.ora (ex: patrimonio_high)
#
DB_CONNECTION=oracle
DB_TNS=nome_do_servico_high
DB_HOST=
DB_PORT=1522
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=AL32UTF8
DB_SERVER_VERSION=19c

# ─── Sessão ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@seu-dominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
